  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Quirrel \n\nEra el brillante aprendiz de la So\xF1adora Monomon, quien
    lo envi\xF3 fuera de Hallownest para protegerlo del olvido y la infecci\xF3n,
    sellando sus recuerdos con una m\xE1scara especial. \n\nA\xF1os despu\xE9s, atra\xEDdo
    misteriosamente de regreso al reino, recupera su memoria al reencontrarse con
    su mentora y, tras aceptar su pasado y cumplir su prop\xF3sito, decide quitarse
    la m\xE1scara para descansar pac\xEDficamente en las aguas de la Orilla del Blando."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
